#!/bin/sh
# sqm-autotune — find the highest shaper rate that still holds latency down.
#
#   sqm-autotune --down          tune download only
#   sqm-autotune --up            tune upload only
#   sqm-autotune --both          both, download first
#   sqm-autotune --apply         write the result to /etc/config/sqm
#
# WHY THIS IS A BISECTION AND NOT A SPEEDTEST
#   The number you want is not your line rate. It is the highest rate at which
#   the shaper is still the bottleneck rather than the modem — because the
#   moment the modem's buffer becomes the queue, you get its buffering
#   behaviour instead of CoDel's, and that is the whole thing SQM exists to
#   prevent. Set it too low and you give away throughput; too high and the
#   shaper stops doing anything. "85-90% of measured" is folklore that
#   approximates this; measuring it directly is better.
#
#   So: saturate the link at a candidate rate, watch what happens to RTT, and
#   bisect for the point where latency starts to climb.
#
# HONEST LIMITATIONS — read before trusting the output
#   * Load is generated BY THE ROUTER. Router-originated traffic uses the main
#     table and skips pbr, the bridges and the NSS forwarding path, so it is
#     not identical to a LAN host pulling through a tunnel. It is close enough
#     to find the knee, not close enough to be a benchmark.
#   * Needs the network otherwise idle. Anything else using the link during a
#     run lands in the measurement as latency you will then tune around.
#   * Your WAN is behind an ISP router doing NAT (192.168.0.1). Its buffering
#     is part of what you are measuring and is not separable from here.
#   * ~4 minutes per direction. Run it when nobody needs the internet.

set -u

DIR=""
APPLY=0
# RTT probe target. 1.1.1.1 is deliberately NOT first: some ISPs (Vodafone
# among them) filter or hijack it, and a filtered target silently produces a
# baseline of 9999 ms and a nonsense tuning result. The list is probed in
# order and the first that answers is used.
TARGET_CANDIDATES="${TARGET_CANDIDATES:-9.9.9.9 8.8.8.8 208.67.222.222 1.1.1.1}"
TARGET_HOST="${TARGET_HOST:-}"
DL_URL="${DL_URL:-http://speedtest.tele2.net/100MB.zip}"
SAMPLE=20                                   # probes (and seconds) of load per candidate
TOLERANCE_MS="${TOLERANCE_MS:-10}"          # allowed RTT rise over baseline
IFACE="${IFACE:-wan}"

for a in "$@"; do
	case "$a" in
		--down) DIR="download" ;;
		--up) DIR="upload" ;;
		--both) DIR="both" ;;
		--apply) APPLY=1 ;;
		*) echo "usage: $0 [--down|--up|--both] [--apply]" >&2; exit 2 ;;
	esac
done
[ -n "$DIR" ] || { echo "pick a direction: --down, --up or --both" >&2; exit 2; }

need() { command -v "$1" >/dev/null 2>&1 || { echo "missing: $1" >&2; exit 1; }; }
need curl; need ping; need awk

say() { printf '%s\n' "$*" >&2; }

# --- RTT sampling -----------------------------------------------------------
# p95 rather than mean: bufferbloat shows up as a tail, and a mean over a
# 20-second window hides a queue that is full half the time.
rtt_p95() {
	local secs="$1" n
	# `ping -i 0.2` is why every baseline came back 9999. BusyBox ping takes an
	# INTEGER interval; a fractional one makes it error out, print nothing, and
	# the sed below yields no samples. One probe per second is plenty.
	n="$secs"
	ping -c "$n" -W 2 "$TARGET_HOST" 2>/dev/null \
		| sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' \
		| sort -n \
		| awk '{v[NR]=$1}
		       END {
		         if (NR == 0) { print "9999"; exit }
		         i = int(NR * 0.95); if (i < 1) i = 1;
		         print v[i]
		       }'
}

baseline() {
	say "  measuring idle baseline..."
	local b; b=$(rtt_p95 10)
	say "  baseline p95 RTT: ${b} ms"
	# A 9999 baseline means the probe produced no samples at all. Carrying on
	# would make every candidate "pass" — rise = 9999-9999 = 0 — and the
	# bisection would walk straight to the ceiling and report a rate several
	# times the line speed. That is exactly the 646816/323407 result.
	if awk -v b="$b" 'BEGIN{exit !(b >= 9999)}'; then
		say "  !! no RTT samples from ${TARGET_HOST}."
		say "     check: ping -c3 ${TARGET_HOST}"
		say "     then re-run with TARGET_HOST=<something reachable>"
		exit 1
	fi
	echo "$b"
}

# --- load generators --------------------------------------------------------
load_down() { curl -s -o /dev/null --max-time "$1" "$DL_URL" & echo $!; }
load_up() {
	# No upload sink is guaranteed reachable, so saturate with the tunnel
	# instead: a large POST to a discard endpoint, falling back to flooding
	# the WAN gateway if none is available.
	curl -s -o /dev/null --max-time "$1" -T /dev/zero "${UP_URL:-http://speedtest.tele2.net/upload.php}" & echo $!
}

# --- one candidate ----------------------------------------------------------
probe() {
	local dir="$1" rate="$2" base="$3" pid p95 rise
	uci -q set "sqm.${IFACE}.${dir}=${rate}"
	uci -q commit sqm
	/etc/init.d/sqm restart >/dev/null 2>&1
	sleep 3

	case "$dir" in
		download) pid=$(load_down $((SAMPLE + 5))) ;;
		upload)   pid=$(load_up   $((SAMPLE + 5))) ;;
	esac
	sleep 2
	p95=$(rtt_p95 "$SAMPLE")
	kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null

	rise=$(awk -v a="$p95" -v b="$base" 'BEGIN{printf "%.1f", a-b}')
	say "    ${rate} kbit -> p95 ${p95} ms (+${rise} over baseline)"
	awk -v r="$rise" -v t="$TOLERANCE_MS" 'BEGIN{exit !(r <= t)}'
}

# --- bisection --------------------------------------------------------------
tune() {
	local dir="$1" base lo hi mid best
	base=$(baseline)

	# Upper bound: whatever is configured now, doubled. If the current value
	# already passes, the true knee is above it and worth finding.
	hi=$(uci -q get "sqm.${IFACE}.${dir}" || echo 100000)
	hi=$((hi * 2)); lo=$((hi / 8)); best="$lo"

	say "  bisecting ${dir} between ${lo} and ${hi} kbit"
	while [ $((hi - lo)) -gt $((hi / 20)) ]; do
		mid=$(( (lo + hi) / 2 ))
		if probe "$dir" "$mid" "$base"; then best="$mid"; lo="$mid"; else hi="$mid"; fi
	done

	# Back off 5%: the knee is where latency STARTS to rise, and sitting
	# exactly on it means any change in line conditions puts you over.
	best=$(( best * 95 / 100 ))
	say "  ${dir}: ${best} kbit"
	echo "$best"
}

ORIG_DL=$(uci -q get "sqm.${IFACE}.download")
ORIG_UL=$(uci -q get "sqm.${IFACE}.upload")
trap 'uci -q set "sqm.'"$IFACE"'.download='"$ORIG_DL"'"; uci -q set "sqm.'"$IFACE"'.upload='"$ORIG_UL"'"; uci -q commit sqm; /etc/init.d/sqm restart >/dev/null 2>&1; say "restored original rates"' INT TERM

if [ -z "$TARGET_HOST" ]; then
	for c in $TARGET_CANDIDATES; do
		if ping -c2 -W2 -q "$c" >/dev/null 2>&1; then TARGET_HOST="$c"; break; fi
	done
fi
[ -n "$TARGET_HOST" ] || { say "no reachable probe target from: $TARGET_CANDIDATES"; say "set TARGET_HOST= explicitly"; exit 1; }

# WHEN TO RUN THIS
#   Router-originated traffic uses the MAIN routing table, not pbr — pbr's
#   policies match LAN source addresses, and the router's own source is a wan
#   or br-* address. The main table's lowest-metric default is wan (100), so
#   this measures the WAN path directly and the tunnels are not involved.
#   The wan zone's output policy is ACCEPT, so nothing needs opening.
#
#   You do NOT need to bring the tunnels down. You DO need the link otherwise
#   idle: anything else using it lands in the measurement as latency you then
#   tune around.
say "sqm-autotune: interface ${IFACE}, probe ${TARGET_HOST}, tolerance ${TOLERANCE_MS} ms"
say "current: download ${ORIG_DL} upload ${ORIG_UL}"
say ""

NEW_DL="$ORIG_DL"; NEW_UL="$ORIG_UL"
case "$DIR" in
	download|both) say "== download =="; NEW_DL=$(tune download) ;;
esac
case "$DIR" in
	upload|both) say ""; say "== upload =="; NEW_UL=$(tune upload) ;;
esac

trap - INT TERM
say ""
say "result:  download ${NEW_DL}  upload ${NEW_UL}"
say "current: download ${ORIG_DL}  upload ${ORIG_UL}"

if [ "$APPLY" = "1" ]; then
	uci -q set "sqm.${IFACE}.download=${NEW_DL}"
	uci -q set "sqm.${IFACE}.upload=${NEW_UL}"
	uci commit sqm
	/etc/init.d/sqm restart >/dev/null 2>&1
	say "applied and committed."
else
	uci -q set "sqm.${IFACE}.download=${ORIG_DL}"
	uci -q set "sqm.${IFACE}.upload=${ORIG_UL}"
	uci -q commit sqm
	/etc/init.d/sqm restart >/dev/null 2>&1
	say "NOT applied — original rates restored. Re-run with --apply to keep."
fi
