## /etc/config/network
## Ported from the 6.1 build. Changes vs. current are marked [CHANGED].

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fdb6:747a:d337::/48'
	# [CHANGED] was '1'. netifd's steering fights the NSS RPS mask; nss-tools
	# forces this off at runtime anyway, so set it explicitly to stop them
	# arguing on every interface event.
	option packet_steering '0'

##############################################################################
## Wired ports
##############################################################################
## [CHANGED] rpfilter dropped throughout. Strict reverse-path filtering and
## policy routing into multiple tunnels are a bad pair: strict validates the
## return path against the main table, which pbr deliberately diverges from.
## Loose (2) is set globally in sysctl.d and keeps the anti-spoofing you want.

config device
	option name 'lan1'
	option macaddr '52:AA:09:87:24:E1'
	option multicast_router '1'
	option multicast_fast_leave '1'

config device
	option name 'lan2'
	option macaddr '52:AA:09:87:24:E2'
	option multicast_router '1'
	option multicast_fast_leave '1'

config device
	option name 'lan3'
	option macaddr '52:AA:09:87:24:E3'
	option multicast_router '1'
	option multicast_fast_leave '1'

config device
	option name 'wan'
	option macaddr '6A:0A:9E:4B:EF:EF'
	option acceptlocal '1'
	option multicast '0'

##############################################################################
## Bridges — one physical port per zone, guest is wireless-only
##############################################################################
## [CHANGED] stp '1' removed from all four. Each bridge has a single physical
## port; no loop is constructible without external hardware. What STP costs
## you is forwarding delay on every port and VAP state change, i.e. slower
## association, every single day.

config device
	option name 'br-svc'
	option type 'bridge'
	list ports 'lan1'
	option mtu '1500'
	option macaddr '52:AA:09:87:24:C6'
	option igmp_snooping '1'
	option bridge_empty '1'

config device
	option name 'br-private'
	option type 'bridge'
	list ports 'lan2'
	option mtu '1500'
	option macaddr '52:AA:09:87:24:C5'
	option igmp_snooping '1'
	option bridge_empty '1'

config device
	option name 'br-iot'
	option type 'bridge'
	list ports 'lan3'
	option mtu '1500'
	option macaddr '52:AA:09:87:24:C3'
	option igmp_snooping '1'
	option bridge_empty '1'

## [CHANGED] declared explicitly. Previously implicit, which meant its
## existence depended on netifd inferring it.
## MEDIA — wireless-only, like guest. Lives on the ath11k 2.4 GHz radio, which
## has been idle since private/guest moved to 5 GHz only. 2x2 at 40 MHz is
## ~286 Mbit/s, which is ample for two TVs and far better than the 1x1 ath10k.
config device
	option name 'br-media'
	option type 'bridge'
	option mtu '1500'
	option macaddr '52:AA:09:87:24:C7'
	option igmp_snooping '1'
	option bridge_empty '1'

config device
	option name 'br-guest'
	option type 'bridge'
	option mtu '1500'
	option macaddr '52:AA:09:87:24:C4'
	option igmp_snooping '1'
	option bridge_empty '1'

##############################################################################
## WAN
##############################################################################

## RESTORED. I had reduced these to proto+device and dropped everything else.
##
## macaddr here is the INTERFACE mac (6A:0A:9E:4F:DE:AC) and is deliberately
## different from the `config device` wan mac (6A:0A:9E:4B:EF:EF) above — the
## former is what the ISP sees on DHCP.
##
## hostname 'DELL-W8401BC' is the DHCP client hostname sent upstream. It is a
## decoy, not a typo. Do not "fix" it.
##
## peerdns '0' + explicit `list dns`: the ISP's resolvers are never used, even
## for the router's own bootstrap.
##
## delegate '0' on both: no prefix delegation downstream from wan. Your LAN v6
## is ULA-only, which is why ip6hint pinning works at all.

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'
	option macaddr '6A:0A:9E:4F:DE:AC'
	option hostname 'DELL-W8401BC'
	option peerdns '0'
	list dns '1.1.1.1'
	list dns '1.0.0.1'
	option delegate '0'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'
	option iface_464xlat '0'
	option reqaddress 'try'
	option reqprefix 'auto'
	option peerdns '0'
	list dns '2606:4700:4700::1111'
	option delegate '0'

##############################################################################
## Zones
##############################################################################
## [CHANGED] ip6hint added to all four. Your /64s are currently assigned in
## netifd allocation order, which happens to give guest :0, iot :1,
## private :2, svc :3, media :4. After a clean -n flash that order is NOT guaranteed.
## If it shuffles, all four IPv6 pbr rules point at the wrong zones and the
## DNS hijack's Pi-hole address stops being Pi-hole — silently, because v4
## keeps working. These four lines make it deterministic.

config interface 'guest'
	option proto 'static'
	option device 'br-guest'
	option ipaddr '192.168.33.1'
	option netmask '255.255.255.0'
	option ip6assign '64'
	option ip6hint '0'
	option mtu '1500'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

config interface 'media'
	option proto 'static'
	option device 'br-media'
	option ipaddr '192.168.34.1'
	option netmask '255.255.255.0'
	option ip6assign '64'
	option ip6hint '4'
	option mtu '1500'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

config interface 'iot'
	option proto 'static'
	option device 'br-iot'
	option ipaddr '192.168.32.1'
	option netmask '255.255.255.0'
	option ip6assign '64'
	option ip6hint '1'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

config interface 'private'
	option proto 'static'
	option device 'br-private'
	option ipaddr '192.168.37.1'
	option netmask '255.255.255.0'
	option ip6assign '64'
	option ip6hint '2'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

config interface 'svc'
	option proto 'static'
	option device 'br-svc'
	option ipaddr '192.168.137.1'
	option netmask '255.255.255.0'
	option ip6assign '64'
	option ip6hint '3'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

##############################################################################
## WireGuard
##############################################################################
## MTU kept at 1320 for the migration — one variable at a time. Once the port
## is verified, test 1420: WireGuard here is packet-rate-bound, not
## bandwidth-bound, so ~7.5% fewer packets for the same bytes is close to a
## straight throughput win. Validate with `ping -M do -s 1392 <endpoint>` and
## watch for handshake failures — 15-wan.nft drops fragments.
##
## PRIVATE -> wg0 | SVC -> wg1 | GUEST -> wg2 | IOT -> wg3 | MEDIA -> wg4
##
## NO KEY MATERIAL IN THIS FILE. Interfaces are declared without private_key
## and carry no peers; they will fail to come up until inject-secrets.sh runs.
## That failure mode is correct — fail-closed means no tunnel, no egress.
##
## Peers, private keys, PSKs and endpoints are applied post-flash from your
## BitLocker stick. See inject-secrets.sh.

## Per-interface: addresses, dns, private_key and peers are ALL injected
## post-flash by inject-secrets.sh — they are per-key assignments from the
## provider and belong with the key, not in a build artifact.
##
## force_link '1' is load-bearing for fail-closed. Without it netifd tears the
## interface down when the tunnel drops, its routes vanish, and the lookup
## falls back to the main table. With it, the interface and route persist and
## the packet is dropped instead of re-routed. That is the innermost of three
## layers: force_link, then pbr strict_enforcement, then the firewall having
## no LAN->wan forwarding at all.
##
## peerdns '0' keeps the provider's resolvers out of the router's resolv.conf;
## the explicit `list dns` entries are injected alongside the addresses.

config interface 'wg0'
	option proto 'wireguard'
	option mtu '1320'
	option listen_port '31337'
	option force_link '1'
	option peerdns '0'
	## nohostroute must stay 0: netifd adds a host route to each peer endpoint
	## via the current default gateway. Suppress it and the encapsulated
	## packets get policy-routed into the tunnel they are meant to carry.
	option nohostroute '0'

config interface 'wg1'
	option proto 'wireguard'
	option mtu '1320'
	option listen_port '31338'
	option force_link '1'
	option peerdns '0'
	option nohostroute '0'

config interface 'wg2'
	option proto 'wireguard'
	option mtu '1320'
	option listen_port '31339'
	option force_link '1'
	option peerdns '0'
	option nohostroute '0'

## wg3 — SVC only, so DNS stops sharing an exit with IOT.
## That coupling was the one structural wart left: Pi-hole lives in SVC and
## every zone's DNS is hijacked to it, so a wg1 outage cost name resolution
## network-wide even for zones whose own tunnel was healthy. wg3 decouples it.
config interface 'wg3'
	option proto 'wireguard'
	option mtu '1320'
	option listen_port '31340'
	option force_link '1'
	option peerdns '0'
	option nohostroute '0'

## wg4 — MEDIA. Separate tunnel rather than sharing wg3 with IOT: torrent and
## appliance traffic in one failure domain means a P2P-related block takes the
## thermostats with it. A fifth tunnel costs a few MB of RAM and one more
## handshake, not throughput.
config interface 'wg4'
	option proto 'wireguard'
	option mtu '1320'
	option listen_port '31341'
	option force_link '1'
	option peerdns '0'
	option nohostroute '0'

config interface 'wg60'
	option proto 'static'
	option device '@wg0'

config interface 'wg61'
	option proto 'static'
	option device '@wg1'

config interface 'wg62'
	option proto 'static'
	option device '@wg2'

config interface 'wg63'
	option proto 'static'
	option device '@wg3'

config interface 'wg64'
	option proto 'static'
	option device '@wg4'

##############################################################################
## Default routes with metrics — RESTORED, I had dropped all 8 of these
##############################################################################
## WireGuard interfaces are configured with route_allowed_ips=0 so that pbr
## owns the routing decision. The side effect is that netifd installs NO
## default route for wg0/wg1/wg2 anywhere — which leaves pbr nothing stable to
## copy into its policy tables. These make the per-interface defaults explicit
## and preserve your metric hierarchy: wan 100, wg0 200, wg1 300, wg2 400.
##
## Peer endpoint host routes (e.g. 62.169.136.103 via 192.168.0.1 dev wan) are
## added automatically because nohostroute is 0. Do not add those by hand.

config route
	option interface 'wan'
	option target '0.0.0.0/0'
	option metric '100'

config route6
	option interface 'wan6'
	option gateway 'fe80::1'
	option target '::/0'
	option metric '100'

config route
	option interface 'wg0'
	option target '0.0.0.0/0'
	option metric '200'

config route6
	option interface 'wg60'
	option target '::/0'
	option metric '200'

config route
	option interface 'wg1'
	option target '0.0.0.0/0'
	option metric '300'

config route6
	option interface 'wg61'
	option target '::/0'
	option metric '300'

config route
	option interface 'wg2'
	option target '0.0.0.0/0'
	option metric '400'

config route6
	option interface 'wg62'
	option target '::/0'
	option metric '400'

config route
	option interface 'wg3'
	option target '0.0.0.0/0'
	option metric '500'

config route6
	option interface 'wg63'
	option target '::/0'
	option metric '500'

config route
	option interface 'wg4'
	option target '0.0.0.0/0'
	option metric '600'

config route6
	option interface 'wg64'
	option target '::/0'
	option metric '600'

##############################################################################
## AmneziaWG mirrors — awg0..awg4
##############################################################################
## One awg interface per wg interface, same key, same address, same peers.
## Exactly ONE SET IS LIVE AT A TIME: inject-secrets.sh populates whichever
## TUNNEL_PROTO selects and disables the other. Running both would mean two
## sessions per Proton key, which is not something to discover at 2am.
##
## PARAMETERS — the vanilla-compatible subset only:
##   awg_jc 4, awg_jmin 40, awg_jmax 70   junk packets before the handshake
##   awg_s1 0, awg_s2 0                   NO handshake padding; breaks Proton
##   awg_h1..h4 = 1,2,3,4                 stock message types; anything else
##                                        breaks Proton
## Changing s1/s2/h1-h4 away from these values requires a server that also
## speaks AmneziaWG. Proton does not.

config interface 'awg0'
	option proto 'amneziawg'
	option mtu '1320'
	option listen_port '31337'
	option force_link '1'
	option peerdns '0'
	option nohostroute '0'
	option disabled '1'
	option awg_jc '4'
	option awg_jmin '40'
	option awg_jmax '70'
	option awg_s1 '0'
	option awg_s2 '0'
	option awg_h1 '1'
	option awg_h2 '2'
	option awg_h3 '3'
	option awg_h4 '4'

config interface 'awg1'
	option proto 'amneziawg'
	option mtu '1320'
	option listen_port '31338'
	option force_link '1'
	option peerdns '0'
