## /etc/config/sqm
##
## This IS the port of the tc commands you were running by hand:
##
##   insmod nss-ifb nss_dev_name=wan; ip link set up nssifb
##   tc qdisc add dev nssifb root handle 1: nsstbl rate 350Mbit burst 4Mb
##   tc qdisc add dev nssifb parent 1: handle 10: nssfq_codel ... set_default
##   tc qdisc add dev wan    root handle 1: nsstbl rate 150Mbit burst 4Mb
##   tc qdisc add dev wan    parent 1: handle 10: nssfq_codel ... set_default
##
## `script 'nss-edma.qos'` from sqm-scripts-nss builds exactly that: nsstbl as
## the shaper, nssfq_codel as the leaf, nssifb for the ingress direction, and
## it loads/creates nssifb itself. So the `config interface 'nssifb'` in
## /etc/config/network is now redundant bookkeeping rather than load-bearing —
## harmless, and worth keeping as documentation of where the device comes from.
##
## Shaping on `wan` only is correct, and the tunnels do not change that. The
## bottleneck is the physical WAN link; WireGuard traffic crosses it as UDP
## like everything else, so shaping wan covers every tunnel at once. Shaping
## per-tunnel would shape the plaintext side and leave the real queue
## unmanaged. (WireGuard has no shaper of its own — it has a small internal
## queue, which is not the same thing.)
##
## TUNING: download/upload are in kbit and should sit at roughly 85-90% of
## your measured line rate. Below that you give away throughput; above it the
## modem's own buffer becomes the queue again and bufferbloat returns.

config queue 'wan'
	option enabled '1'
	option interface 'wan'
	option download '335000'
	option upload '165000'
	option qdisc 'fq_codel'
	option script 'nss-edma.qos'
	option linklayer 'none'
	option qdisc_advanced '1'
	option qdisc_really_really_advanced '1'
	option itarget '4ms'
	option etarget '4ms'
	option iqdisc_opts 'interval 50ms quantum 304'
	option eqdisc_opts 'interval 20ms quantum 304'
	option elimit '150'
	## Ingress shaping on the LAN ports, so a LAN host cannot fill the
	## upstream queue faster than the shaper drains it.
	option igs_upload 'lan1 lan2 lan3'
