## /etc/config/system — carried from your 6.1 config.

config system
	option hostname 'XiaoQiang'
	option timezone 'EET-2EEST,M3.5.0/3,M10.5.0/4'
	option zonename 'Europe/Bucharest'
	option ttylogin '0'
	option log_size '64'
	option log_proto 'udp'
	option urandom_seed '1'
	option zram_comp_algo 'zstd'
	option conloglevel '5'
	option cronloglevel '9'
	option compat_version '1.0'
	## Makes the builder's devices/common/files/etc/uci-defaults/999-QOL_config
	## exit immediately. It runs at 999 (after 97/98/99) and its first action is
	## `set firewall.@zone[1].input='DROP'` — positional. Upstream's @zone[1] is
	## `wan`; ours is `svc`. The script documents this marker as the opt-out.
	## Harmless if your fork predates that file.
	option qol_defaults '1'

## NTP is handled by chrony (see /etc/config/chrony), NOT by busybox sysntpd.
## sysntpd cannot do NTS and cannot serve the LAN; chrony does both.
## Explicitly disabled so the two never race to discipline the clock.
config timeserver 'ntp'
	option enabled '0'
	option enable_server '0'

##############################################################################
## LEDs
##############################################################################
## WARNING — verify these after first boot.
## `sysfs 'ath10k-phy0'` and `dev 'phy0-ap0'` assume the ath10k IoT radio is
## phy0. On this build upstream's static wireless declares radio0 = ath11k 5G
## and radio1 = ath11k 2.4G, so the ath10k is likely phy2 (or absent). Check:
##     ls -l /sys/class/leds/ | grep -i ath10k
##     iw dev
## and fix `sysfs`/`dev` to match, or the IOT LED silently does nothing.

config led 'led_wan'
	option trigger 'netdev'
	option sysfs 'ath10k-phy0'
	option dev 'phy0-ap0'
	option name 'IOT'
	list mode 'tx'
	list mode 'rx'

config led
	option sysfs 'blue:network'
	option trigger 'netdev'
	option dev 'wan'
	list mode 'tx'
	list mode 'rx'
	option name 'WAN - RX/TX'

config led
	option trigger 'netdev'
	option dev 'wan'
	list mode 'link'
	option sysfs 'blue:system'
	option name 'WAN - Link On'

## Requires rng-tools, which I had pruned — restored in the package list.
## Note: on 6.18 the entropy pools are unified, so rngd reading /dev/urandom
## and writing back to it is a no-op. `urandom_seed '1'` above is the part
## that actually does something. Kept because it is your config; safe to drop
## along with CONFIG_PACKAGE_rng-tools if you want it gone.
config rngd
	option enabled '1'
	option device '/dev/urandom'
