config host` sections. The collector
## redacted broadly so the MACs did not survive; recover them from the Phase 0
## backup:
##     tar xzf backup-*.tar.gz -O etc/config/dhcp | awk '/^config host/,/^$/'
##
## The resolver MUST land on 192.168.137.2 — that address is hardcoded in
## /etc/nftables.d/20-dnshijack.nft. Give it `option hostid '2'` so its v6
## address is the static fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb rather than a MAC-derived SLAAC
## address that breaks when you swap the Pi for the UDOO.
config host
	option name 'pihole'
	option ip '192.168.137.2'
	option mac 'b8:27:eb:6e:5a:eb'
	option hostid '0aeb'
	option duid '00010001282ebbd4b827eb6e5aeb'

config host
	option name 'hue-Bridge'
	option ip '192.168.32.132'
	option mac 'ec:b5:fa:2a:7b:fd'
	option hostid '7bfd'
	option dns '1'

config host
	option name 'HP7E74CC'
	option ip '192.168.32.191'
	option mac 'FC:3F:DB:7E:74:CD'
	option hostid '04cd'
	option duid '000100012A5274D0FC3FDB7E74CD'

## v6 RESOLVER ADDRESS — now consistent everywhere, on the one that works.
##
## Your Pi currently holds three v6 addresses:
##     fdb6:747a:d337:3::1b7                     odhcpd pool assignment
##     fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb      SLAAC, EUI-64 from the MAC
##     fe80::ba27:ebff:fe6e:5aeb                 link-local
##
## Note what is NOT there: ::aeb. `hostid '0aeb'` is being ignored, because
## odhcpd matches DHCPv6 clients by DUID and the `duid` in the host entry does
## not match the one NetworkManager actually sends — so the Pi is treated as
## an unknown client and served from the pool. That is why it has ::1b7.
##
## So ::2 was never going to work either, and my earlier "set hostid 2" advice
## was wrong for the same reason. Everything now points at the SLAAC address,
## which is stable as long as the NIC is (NetworkManager has addr-gen-mode=eui64).
##
## To go back to a hostid-based address later, fix the DUID first:
##     pi$ sudo cat /var/lib/NetworkManager/secret_key   # or dhcpcd duid
## and put the real value in `option duid` here.
