## /etc/config/dhcp
## dnsmasq here is DHCP + local domain only. Actual resolution is hijacked to
## Pi-hole at 192.168.137.2 by /etc/nftables.d/20-dnshijack.nft, so the
## router's own resolver is a fallback, not the path clients take.

config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '1'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option expandhosts '1'
	option nonegcache '1'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option noresolv '0'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '1'
	option ednspacket_max '1232'
	option dnssec '1'
	option dnsseccheckunsigned '1'
	option local '/intra/'
	option domain 'intra'
	## Bind to the four LAN bridges only, never wan or the tunnels.
	option nonwildcard '1'
	list interface 'br-svc'
	list interface 'br-iot'
	list interface 'br-guest'
	list interface 'br-private'
	## picks up /etc/dnsmasq.d/10-doh-nftset.conf (the @doh/@doh6 population)
	option confdir '/tmp/dnsmasq.d'
	list addnmount '/etc/dnsmasq.d'
	## added by pbr for its resolver set support
	list addnmount '/var/run/pbr.dnsmasq'
	##
	## SPLIT-DNS BOOTSTRAP ESCAPE HATCH — do not remove without thinking.
	## These three domains resolve directly via 1.1.1.1 instead of through
	## the resolver. That is what lets the router still reach openwrt.org for
	## updates, raw.githubusercontent for scripts, and ntp.org for time when
	## the resolver host is down or wg1 is blackholed. Given SVC and IOT share
	## wg1, a wg1 outage takes DNS out network-wide — these are the crack of
	## light under that door.
	list server '/openwrt.org/1.1.1.1'
	list server '/raw.githubusercontent.com/1.1.1.1'
	list server '/ntp.org/1.1.1.1'
	## Upstream resolver. v6 is now the STATIC address, not the SLAAC address
	## derived from the Pi's MAC — assign fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb on that host.
	list server '192.168.137.2'
	list server 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

##############################################################################
## Per-zone pools — RESTORED FROM YOUR CONFIG
##############################################################################
## I had invented start/limit/leasetime for all four and dropped every RA and
## dhcp_option line. What was lost, and why each matters:
##
##   ra_management '1'   clients take addresses from DHCPv6, not SLAAC alone
##   ra_default '1'      advertise as default router even without a global v6
##   ra_preference       router preference in the RA
##   ndp 'disabled'      no NDP proxying between zones
##
##   dhcp_option 43 '01:04:00:00:00:02'
##       Microsoft vendor-specific: NetBIOS-over-TCP/IP node type = P-node.
##       Kills broadcast NBT name resolution, i.e. LLMNR/NBT-NS poisoning.
##   dhcp_option 44
##       WINS server, explicitly empty. Same target from the other side.
##   dhcp_option 252 '"\n"'
##       WPAD. An empty PAC URL is the standard defence against WPAD
##       hijacking. Dropping it silently re-opened a Responder-class hole on
##       every zone.
##
## These three are the "security!" you were referring to and I removed all of
## them without noticing what they were.

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'
	option start '100'
	option limit '150'
	option leasetime '12h'

config dhcp 'wan6'
	option interface 'wan6'
	option ignore '1'

config dhcp 'svc'
	option interface 'svc'
	option dhcpv4 'server'
	option start '2'
	option limit '64'
	option dhcpv6 'server'
	option ra 'server'
	option ra_management '1'
	option ra_default '1'
	option ra_preference 'high'
	option ra_flags 'managed-config other-config'
	## NTP is NOT advertised. Option 42 would tell clients where the time
	## server is; /etc/nftables.d/30-ntphijack.nft DNATs every UDP/123 to the
	## zone gateway regardless, so advertising it adds a second mechanism that
	## can disagree with the first. The hijack catches clients with hardcoded
	## servers too, which option 42 cannot. One mechanism.
	##
	## dhcpv4 'server' IS set on every zone. It is required — confirmed twice
	## empirically, on two separate images, and I was wrong to argue against it
	## from theory both times.
	##
	## What is NOT explained: your logs show every DHCPACK coming from dnsmasq
	## and nothing at all from odhcpd, so odhcpd is not the thing serving. The
	## flag changes something that makes dnsmasq's DHCP work, and I do not know
	## what. Do not remove it to find out.
	##
	## Leading hypothesis, yours: these bridges have no carrier until a client
	## associates or a cable is plugged, and dnsmasq with bind-dynamic
	## (nonwildcard '1') will not bind DHCP to an interface in that state.
	## Setting dhcpv4 makes odhcpd open its own socket on the interface, which
	## may be what forces it to a usable state. See the bisection note at the
	## bottom of this file.
	##
	## ROOT CAUSE of the DHCP outage, since it was not what either of us
	## thought: UCI aborts an entire file on a malformed line rather than
	## skipping the bad section. The mangled comment made /etc/config/dhcp
	## wholly unreadable, so dnsmasq started with NO config and there were no
	## ranges on any bridge. Enabling the DHCP server from LuCI fixed it
	## because LuCI rewrote the file through uci, which normalised it and
	## dropped the bad line — the dhcpv4 option itself did nothing.
	##
	## Worth remembering as a class: one bad character anywhere in a UCI file
	## silently disables every service that reads it.
	##
	## Option 6 here and `option dns` below are NOT redundant: option 6 is
	## DHCPv4, `option dns` feeds RA/DHCPv6. Different families, both needed.
	list dhcp_option '6,192.168.137.2'
	list dhcp_option '43,01:04:00:00:00:02'
	list dhcp_option '44'
	list dhcp_option '252,"\n"'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

config dhcp 'iot'
	option interface 'iot'
	option dhcpv4 'server'
	option limit '254'
	option dhcpv6 'server'
	option ra 'server'
	option ra_management '1'
	option ra_default '1'
	option ra_preference 'high'
	option ra_flags 'managed-config other-config'
	list dhcp_option '6,192.168.137.2'
	list dhcp_option '43,01:04:00:00:00:02'
	list dhcp_option '44'
	list dhcp_option '252,"\n"'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

config dhcp 'guest'
	option interface 'guest'
	option dhcpv4 'server'
	option start '2'
	option limit '250'
	option leasetime '6h'
	option dhcpv6 'server'
	option ra 'server'
	option ra_management '1'
	option ra_default '1'
	option ra_flags 'managed-config other-config'
	list dhcp_option '6,192.168.137.2'
	list dhcp_option '43,01:04:00:00:00:02'
	list dhcp_option '44'
	list dhcp_option '252,"\n"'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

config dhcp 'private'
	option interface 'private'
	option dhcpv4 'server'
	option start '5'
	option limit '250'
	option leasetime '6h'
	option dhcpv6 'server'
	option ra 'server'
	option ra_management '1'
	option ra_default '1'
	option ra_preference 'high'
	option ra_flags 'managed-config other-config'
	list dhcp_option '6,192.168.137.2'
	list dhcp_option '43,01:04:00:00:00:02'
	list dhcp_option '44'
	list dhcp_option '252,"\n"'
	list dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/odhcpd.leases'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '3'
	option piodir '/tmp/odhcpd-piodir'
	option hostsdir '/tmp/hosts'

## Static leases. Your old /etc/config/dhcp had three `config host` sections;
## they are carried below. The collector
## redacted broadly so the MACs did not survive; recover them from the Phase 0
## backup:
##     tar xzf backup-*.tar.gz -O etc/config/dhcp | awk '/^config host/,/^$/'
##
## The resolver MUST land on 192.168.137.2 — that address is hardcoded in
## /etc/nftables.d/20-dnshijack.nft, and its v6 address is the SLAAC address
## fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb, which every `option dns` above and the
## hijack now agree on. hostid is ignored here because odhcpd matches DHCPv6 by
## DUID and the duid below is not the one NetworkManager sends.
config host
	option name 'pihole'
	option ip '192.168.137.2'
	option mac 'b8:27:eb:6e:5a:eb'
	option hostid '0aeb'
	option duid '00010001282ebbd4b827eb6e5aeb'

config host
	option name 'Hue-Bridge'
	option ip '192.168.32.132'
	option mac 'ec:b5:fa:2a:7b:fd'
	option hostid '7bfd'
	option dns '1'

config host
	option name 'HP7E74CC'
	option ip '192.168.32.191'
	option mac 'FC:3F:DB:7E:74:CD'
	option hostid '04cd'
	option duid '000100012A5274D0FC3FDB7E74CD'

## v6 RESOLVER ADDRESS — now consistent everywhere, on the one that works.
##
## Your Pi currently holds three v6 addresses:
##     fdb6:747a:d337:3::1b7                     odhcpd pool assignment
##     fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb      SLAAC, EUI-64 from the MAC
##     fe80::ba27:ebff:fe6e:5aeb                 link-local
##
## Note what is NOT there: ::aeb. `hostid '0aeb'` is being ignored, because
## odhcpd matches DHCPv6 clients by DUID and the `duid` in the host entry does
## not match the one NetworkManager actually sends — so the Pi is treated as
## an unknown client and served from the pool. That is why it has ::1b7.
##
## So ::2 was never going to work either, and my earlier "set hostid 2" advice
## was wrong for the same reason. Everything now points at the SLAAC address,
## which is stable as long as the NIC is (NetworkManager has addr-gen-mode=eui64).
##
## To go back to a hostid-based address later, fix the DUID first:
##     pi$ sudo cat /var/lib/NetworkManager/secret_key   # or dhcpcd duid
## and put the real value in `option duid` here.

##############################################################################
## OPEN BUG — dhcpv4 'server' is load-bearing and nobody knows why
##############################################################################
## Symptom: without `option dhcpv4 'server'` on the zone sections, no DHCPv4
## on any bridge. Wi-Fi clients associate and stall forever without a lease.
## With it, immediate and reliable. Reproduced across builds and across years.
##
## Bisection, one variable at a time, `/etc/init.d/dnsmasq restart` between:
##
##  1. force_link. Add `option force_link '1'` to the four bridge INTERFACES in
##     /etc/config/network, remove dhcpv4, retest. If DHCP works, carrier state
##     was the cause and force_link is the real fix.
##  2. bind-dynamic. Remove `option nonwildcard '1'` from the dnsmasq section
##     (and the four `list interface` lines), restore dhcpv4-less, retest. If it
##     works, dnsmasq's interface binding was the cause.
##  3. drop_invalid. Set firewall.@defaults[0].drop_invalid='0' and retest — a
##     DHCP DISCOVER from 0.0.0.0 is exactly the kind of thing conntrack calls
##     INVALID.
##  4. Instrument directly:
##       ss -ulpn | grep -E ':67|:547'
##       logread -e dnsmasq | grep -i 'DHCP.*range\|listening'
##     Compare the bound sockets and the "DHCP, IP range" lines with and
##     without the flag. That is the observation that settles it.
