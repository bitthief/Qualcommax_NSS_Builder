## /etc/config/dhcp
## dnsmasq here is DHCP + local domain only. Actual resolution is hijacked to
## Pi-hole at 192.168.137.2 by /etc/nftables.d/20-dnshijack.nft, so the
## router's own resolver is a fallback, not the path clients take.

config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '1'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option expandhosts '1'
	option nonegcache '1'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option noresolv '0'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '1'
	option ednspacket_max '1232'
	option dnssec '1'
	option dnsseccheckunsigned '1'
	option local '/intra/'
	option domain 'intra'
	## Bind to the four LAN bridges only, never wan or the tunnels.
	option nonwildcard '1'
	list interface 'br-svc'
	list interface 'br-iot'
	list interface 'br-guest'
	list interface 'br-private'
	## picks up /etc/dnsmasq.d/10-doh-nftset.conf (the @doh/@doh6 population)
	option confdir '/tmp/dnsmasq.d'
	list addnmount '/etc/dnsmasq.d'
	##
	## SPLIT-DNS BOOTSTRAP ESCAPE HATCH — do not remove without thinking.
	## These three domains resolve directly via 1.1.1.1 instead of through
	## the resolver. That is what lets the router still reach openwrt.org for
	## updates, raw.githubusercontent for scripts, and ntp.org for time when
	## the resolver host is down or wg1 is blackholed. Given SVC and IOT share
	## wg1, a wg1 outage takes DNS out network-wide — these are the crack of
	## light under that door.
	list server '/openwrt.org/1.1.1.1'
	list server '/raw.githubusercontent.com/1.1.1.1'
	list server '/ntp.org/1.1.1.1'
	## Upstream resolver. v6 is now the STATIC address, not the SLAAC address
	## derived from the Pi's MAC — assign fdb6:747a:d337:3::2 on that host.
	list server '192.168.137.2'
	list server 'fdb6:747a:d337:3::2'

config dhcp 'svc'
	option interface 'svc'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv6 'server'
	option ra 'server'
	option ra_slaac '1'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	list dhcp_option '6,192.168.137.2'

config dhcp 'iot'
	option interface 'iot'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv6 'server'
	option ra 'server'
	option ra_slaac '1'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	list dhcp_option '6,192.168.137.2'

config dhcp 'guest'
	option interface 'guest'
	option start '100'
	option limit '150'
	option leasetime '4h'
	option dhcpv6 'server'
	option ra 'server'
	option ra_slaac '1'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	list dhcp_option '6,192.168.137.2'

config dhcp 'private'
	option interface 'private'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv6 'server'
	option ra 'server'
	option ra_slaac '1'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	list dhcp_option '6,192.168.137.2'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '3'

##############################################################################
## Static leases — YOU HAVE 3, FILL THEM IN
##############################################################################
## Your old /etc/config/dhcp has three `config host` sections. The collector
## redacted broadly so the MACs did not survive; recover them from the Phase 0
## backup:
##     tar xzf backup-*.tar.gz -O etc/config/dhcp | awk '/^config host/,/^$/'
##
## The resolver MUST land on 192.168.137.2 — that address is hardcoded in
## /etc/nftables.d/20-dnshijack.nft. Give it `option hostid '2'` so its v6
## address is the static fdb6:747a:d337:3::2 rather than a MAC-derived SLAAC
## address that breaks when you swap the Pi for the UDOO.
config host
	option name 'pihole'
	option ip '192.168.137.2'
	option mac 'b8:27:eb:6e:5a:eb'
	option hostid '2'
	option duid '00010001282ebbd4b827eb6e5aeb'

config host
	option name 'hue-Bridge'
	option ip '192.168.32.132'
	option mac 'ec:b5:fa:2a:7b:fd'
	option hostid '7bfd'
	option dns '1'

config host
	option name 'HP7E74CC'
	option ip '192.168.32.191'
	option mac 'FC:3F:DB:7E:74:CD'
	option hostid '04cd'
	option duid '000100012A5274D0FC3FDB7E74CD'

## NOTE — hostid mismatch, decide before flashing.
## pihole above has hostid '0aeb', which yields fdb6:747a:d337:3::aeb.
## /etc/nftables.d/20-dnshijack.nft and the `list server` line above both
## point at fdb6:747a:d337:3::2. As it stands the v6 hijack redirects to an
## address nothing answers on.
## Either set hostid '2' here (recommended — it survives a hardware swap,
## which was the whole point of moving off the SLAAC address), or change both
## references to ::aeb.
