## /etc/config/dhcp
## dnsmasq here is DHCP + local domain only. Actual resolution is hijacked to
## Pi-hole at 192.168.137.2 by /etc/nftables.d/20-dnshijack.nft, so the
## router's own resolver is a fallback, not the path clients take.

config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '1'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option expandhosts '1'
	option nonegcache '1'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option noresolv '0'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '1'
	option ednspacket_max '1232'
	option dnssec '1'
	option dnsseccheckunsigned '1'
	option local '/intra/'
	option domain 'intra'
	## Bind to the four LAN bridges only, never wan or the tunnels.
	option nonwildcard '1'
	list interface 'br-svc'
	list interface 'br-iot'
	list interface 'br-guest'
	list interface 'br-private'
	## picks up /etc/dnsmasq.d/10-doh-nftset.conf (the @doh/@doh6 population)
	option confdir '/tmp/dnsmasq.d'
	list addnmount '/etc/dnsmasq.d'
	##
	## SPLIT-DNS BOOTSTRAP ESCAPE HATCH — do not remove without thinking.
	## These three domains resolve directly via 1.1.1.1 instead of through
	## the resolver. That is what lets the router still reach openwrt.org for
	## updates, raw.githubusercontent for scripts, and ntp.org for time when
	## the resolver host is down or wg1 is blackholed. Given SVC and IOT share
	## wg1, a wg1 outage takes DNS out network-wide — these are the crack of
	## light under that door.
	list server '/openwrt.org/1.1.1.1'
	list server '/raw.githubusercontent.com/1.1.1.1'
	list server '/ntp.org/1.1.1.1'
	## Upstream resolver. v6 is now the STATIC address, not the SLAAC address
	## derived from the Pi's MAC — assign fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb on that host.
	list server '192.168.137.2'
	list server 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

##############################################################################
## Per-zone pools — RESTORED FROM YOUR CONFIG
##############################################################################
## I had invented start/limit/leasetime for all four and dropped every RA and
## dhcp_option line. What was lost, and why each matters:
##
##   ra_management '1'   clients take addresses from DHCPv6, not SLAAC alone
##   ra_default '1'      advertise as default router even without a global v6
##   ra_preference       router preference in the RA
##   ndp 'disabled'      no NDP proxying between zones
##
##   dhcp_option 43 '01:04:00:00:00:02'
##       Microsoft vendor-specific: NetBIOS-over-TCP/IP node type = P-node.
##       Kills broadcast NBT name resolution, i.e. LLMNR/NBT-NS poisoning.
##   dhcp_option 44
##       WINS server, explicitly empty. Same target from the other side.
##   dhcp_option 252 '"\n"'
##       WPAD. An empty PAC URL is the standard defence against WPAD
##       hijacking. Dropping it silently re-opened a Responder-class hole on
##       every zone.
##
## These three are the "security!" you were referring to and I removed all of
## them without noticing what they were.

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'
	option start '100'
	option limit '150'
	option leasetime '12h'

config dhcp 'wan6'
	option interface 'wan6'
	option ignore '1'

config dhcp 'svc'
	option interface 'svc'
	option start '2'
	option limit '64'
	option leasetime '12h'
	option dhcpv6 'server'
	option ra 'server'
	option ra_management '1'
	option ra_default '1'
	option ra_preference 'high'
	option ra_flags 'managed-config other-config'
	option ndp 'disabled'
	list dhcp_option '6,192.168.137.2'
	list dhcp_option '43,01:04:00:00:00:02'
	list dhcp_option '44'
	list dhcp_option '252,"\n"'
	option dns 'fdb6:747a:d337:3:ba27:ebff:fe6e:5aeb'

