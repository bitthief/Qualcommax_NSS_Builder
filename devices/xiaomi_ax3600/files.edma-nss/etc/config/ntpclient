## /etc/config/ntpclient — carried from your 6.1 config.
##
## Every server is pinned to `interface 'wg0'`. That is deliberate and it is
## part of your "nothing goes straight out to WAN" design: router-local
## traffic uses the main table, which egresses via wan, so unpinned NTP would
## be one of the few things leaking in the clear. I had originally dropped
## this file and set system.ntp.enable_server — which would have done exactly
## that. Requires CONFIG_PACKAGE_ntpclient (restored in the package list).

config ntpserver
	option hostname '0.openwrt.pool.ntp.org'
	option port '123'
	option interface 'wg0'

config ntpserver
	option hostname '1.openwrt.pool.ntp.org'
	option port '123'
	option interface 'wg0'

config ntpserver
	option hostname '2.openwrt.pool.ntp.org'
	option port '123'
	option interface 'wg0'

config ntpserver
	option hostname '3.openwrt.pool.ntp.org'
	option port '123'
	option interface 'wg0'

config ntpdrift
	option freq '0'

config ntpclient
	option interval 600
	option interface wg0
