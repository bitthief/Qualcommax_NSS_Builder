## /etc/config/ecm
##
## Section layout matches the package's own qca-nss-ecm.uci exactly: type
## `ecm`, names `global` and `general`. My previous version used
## `config general 'general'` — the wrong section type — which is why none of
## these knobs were doing anything.

config ecm 'global'
	option acceleration_engine 'auto'

config ecm 'general'
	## Your own option, from Feb 2023, still in qca-nss-ecm.init today.
	## Controls the bridge-nf-call-* sysctls at runtime, which is what your
	## old /etc/sysctl.d/11-br-netfilter.conf was trying and failing to do.
	option enable_bridge_filtering '0'

	##########################################################################
	## Offload knobs — driven by disable_offloads.sh, i.e. YOUR script
	##########################################################################
	## These are the ones that fix the "TLS over LAN is silently corrupted"
	## bug you chased years ago. The script survived into this tree; the UCI
	## knobs that arm it default to 0, and my previous ecm config set none of
	## them. So the mechanism was present and inert.
	##
	## disable_offloads is '0' — YOUR measurement, kept. You are seeing 350+
	## Mbit/s per tunnel with offloads on and no TLS corruption, which settles
	## it: the checksum bug lived in the vendor qca-nss-dp datapath, and this
	## build uses upstream qca_edma instead. My '1' was caution without data.
	##
	## If TLS over LAN ever starts failing in that silent, hard-to-attribute
	## way again, this is the first knob to flip.
	option disable_offloads '0'

	## Leave at 0 unless you see specific symptoms. Flow control and interrupt
	## moderation were separate problems from the checksum corruption.
	option disable_flow_control '0'
	option disable_interrupt_moderation '0'
	option disable_gro '0'
	option disable_gro_list '0'
