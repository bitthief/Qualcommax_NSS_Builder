## /etc/config/firewall
##
## RULE ORDER MATTERS. fw4 emits rules in file order, then the `config
## forwarding` jumps last. Every Drop-* rule must therefore appear BEFORE the
## Allow-*-to-WIREGUARD rule for its zone, or it is shadowed and dead.
## That was the bug in the old config — see the note at DoH/DoT below.

config defaults
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	option synflood_protect '1'
	## Drops conntrack-INVALID packets instead of letting them reach a zone
	## chain. Mostly out-of-window TCP and unmatched ICMP errors. Note this is
	## also the flag that hides late RSTs from asymmetric paths, so if you ever
	## chase a "connection hangs then dies" bug, turn it off before concluding
	## it is the tunnel.
	option drop_invalid '1'
	# [CHANGED] both were '1'. An nft flowtable is a competing forwarding
	# engine and fights ECM. Low CPU alone does not prove NSS is doing the
	# work; verify with `nft list ruleset | grep -i flowtable` (must be empty).
	option flow_offloading '0'
	option flow_offloading_hw '0'

##############################################################################
## Zones
##############################################################################
## masq_allow_invalid kept ONLY on wan and wireguard. On the four LAN zones
## masq is '0', so the flag has never done anything there.
##
## NOTE: svc and private still have input ACCEPT — deliberately left to you.
## private is where you administer from, and svc holds the resolver, so both
## have a real reason to reach the router. iot had none. If you want them
## tightened too, they need the same treatment: DROP plus the mDNS input rules
## above, and for private also SSH on 1338 and LuCI on 80/443.
## Historical note:
## That means any appliance in IOT can reach the router's SSH and LuCI on
## 192.168.32.1. Tightening iot to DROP (the DHCP/DHCPv6/NDP rules below
## already cover what clients legitimately need, plus NTP) is a real
## hardening win — but it is a behaviour change, so it is NOT in this
## migration. One line when you want it.

config zone
	option name 'wan'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'DROP'
	option mtu_fix '1'
	option masq '1'
	option masq_allow_invalid '1'
	option masq6 '1'
	option masq6_privacy '1'
	option network 'wan wan6'

config zone
	option name 'svc'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option mtu_fix '1'
	option masq '0'
	option masq6 '0'
	option masq6_privacy '1'
	option network 'svc'

## [CHANGED] input was ACCEPT. That let any appliance in your least-trusted
## zone reach the router's own listeners directly — dnsmasq/odhcpd on 53/67/547,
## uhttpd on 80/443, chrony on 123. Nothing here is or was reachable from WAN
## (the wan zone is input DROP with only DHCP renew and rate-limited ICMP), so
## this is the lateral-movement surface, not the internet-facing one.
##
## Everything an IoT client legitimately needs from the router is already an
## explicit rule below: DHCP, DHCPv6, NDP, NTP, ICMP, IGMP/MLD, and mDNS —
## the last added in this same change, see the note there.
## DNS is unaffected: the hijack DNATs 53/853 to the resolver, which makes it
## forwarded traffic rather than input.
##
## Revert with one word if something breaks, and check `logread` for the zone
## before assuming it did.
config zone
	option name 'iot'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option mtu_fix '1'
	option masq '0'
	option masq6 '0'
	option masq6_privacy '1'
	option network 'iot'

config zone
	option name 'guest'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option mtu_fix '1'
	option masq '0'
	option masq6 '0'
	option masq6_privacy '1'
	option network 'guest'

config zone
	option name 'private'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option mtu_fix '1'
	option masq '0'
	option masq6 '0'
	option masq6_privacy '1'
	option network 'private'

config zone
	option name 'wireguard'
	option input 'DROP'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option mtu_fix '1'
	option masq '1'
	option masq_allow_invalid '1'
	option network 'wg0 wg60 wg1 wg61 wg2 wg62 wg3 wg63'

##############################################################################
## Forwardings — this is what makes fail-closed structural
##############################################################################
## No LAN zone forwards to `wan`. Only `wireguard -> wan`, carrying the
## encapsulated tunnel traffic. So a tunnel dropping cannot leak to WAN even
## if policy routing misfires: the firewall stops it regardless of routing.
##
## [CHANGED] `guest -> iot` blanket forwarding REMOVED. It accepted
## everything, which made the narrow-looking HTTP/HTTPS rule above it
## decorative. Guest now reaches IOT only via the explicit rules below.

config forwarding
	option src 'svc'
	option dest 'wireguard'

config forwarding
	option src 'iot'
	option dest 'svc'

config forwarding
	option src 'iot'
	option dest 'wireguard'

config forwarding
	option src 'guest'
	option dest 'svc'

config forwarding
	option src 'guest'
	option dest 'wireguard'

config forwarding
	option src 'private'
	option dest 'svc'

config forwarding
	option src 'private'
	option dest 'iot'

config forwarding
	option src 'private'
	option dest 'wireguard'

config forwarding
	option src 'wireguard'
	option dest 'wan'

##############################################################################
## SECTION 1 — DoH / DoT blocking
##############################################################################
## THESE MUST COME FIRST.
##
## In the old config these sat below the Allow-*-to-WIREGUARD rules, which
## are unconditional jumps to accept_to_wireguard. Tunnel-bound DoH/DoT was
## therefore accepted before any drop rule saw it — and since no zone
## forwards to wan, *every* egress path is tunnel-bound. The DoH blocking
## has never actually blocked anything. Ordering them first fixes that.
##
## [CHANGED] -to-WIREGUARD variants added for iot and guest. Previously only
## private had them, and even those were shadowed.

## 853 is DoT. 8853 is DoQ (DNS-over-QUIC, RFC 9250) — dropped rather than
## hijacked, deliberately: the resolver does not speak DoQ, so DNAT would send
## the client to something that cannot answer and it would hang rather than
## fall back. A clean drop makes the client fail fast to Do53, which the
## hijack then catches. Same reasoning as the DoH treatment.
config rule
	option name 'Drop-DoT-DoQ-IOT'
	option src 'iot'
	list proto 'tcp'
	list proto 'udp'
	list dest_port '853'
	list dest_port '8853'
	option target 'DROP'

config rule
	option name 'Drop-DoT-DoQ-GUEST'
	option src 'guest'
	list proto 'tcp'
	list proto 'udp'
	list dest_port '853'
	list dest_port '8853'
	option target 'DROP'

config rule
	option name 'Drop-DoT-DoQ-PRIVATE'
	option src 'private'
	list proto 'tcp'
	list proto 'udp'
	list dest_port '853'
	list dest_port '8853'
	option target 'DROP'

## Belt and braces behind the NTP hijack: anything the DNAT misses cannot
