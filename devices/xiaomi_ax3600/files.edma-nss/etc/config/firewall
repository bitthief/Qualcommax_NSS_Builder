	option target 'ACCEPT'

config rule
	option name 'Allow-ICMP-GUEST-to-IOT'
	option src 'guest'
	option dest 'iot'
	option proto 'icmp'
	list icmp_type 'echo-request'
	option family 'ipv4'
	option target 'ACCEPT'

## dest_ip is load-bearing, not decoration. fw4 scopes a dest ZONE inside the
## reject_to_iot helper chain, but emits the LOG inline in forward_guest with
## no oifname constraint — so without an address match this logs every packet
## guest forwards anywhere, including OUT=wg2 traffic that is then accepted by
## the guest->wireguard forwarding a few rules later. The log said "blocked"
## about traffic that was not blocked.
config rule
	option name 'Log-Reject-GUEST-to-IOT'
	option src 'guest'
	option dest 'iot'
	option dest_ip '192.168.32.0/24'
	option target 'REJECT'
	option log '1'
	option log_limit '10/minute'

