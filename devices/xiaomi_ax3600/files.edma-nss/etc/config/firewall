##   Philips Hue: HTTP/HTTPS + SSDP (above) + mDNS (above)
##   Roborock   : mDNS (above) + miIO local protocol on UDP 54321
## Anything missed shows up in the logged reject at the tail. Read logread,
## add a rule, rather than guessing at the IoT protocol surface up front.

config rule
	option name 'Allow-HTTP-HTTPS-GUEST-to-IOT'
	option src 'guest'
	option dest 'iot'
	option proto 'tcp'
	list dest_port '80'
