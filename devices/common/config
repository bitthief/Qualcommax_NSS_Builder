## ======================================================================
## NTP — chrony with NTS
## ======================================================================
# ntpclient no longer exists in the OpenWrt packages feed; only chrony and
# ntpd remain. busybox sysntpd is explicitly disabled in /etc/config/system.
#
# Correction to an earlier claim: ntpclient's `option interface` was a procd
# trigger, not a source bind. It never tunnelled anything.
#
# chrony-nts is the NTS-enabled build variant (CONFLICTS with plain chrony).
# NTS is RFC 8915: TLS 1.3 key establishment on TCP/4460, then AEAD-
# authenticated NTP on UDP/123. It defeats on-path tampering with time, which
# matters more here than usual — a wrong clock breaks TLS everywhere,
# including your ability to fetch anything with which to repair it.
CONFIG_PACKAGE_chrony-nts=y
# Pulled in by the variant, but pinned so a dependency change cannot silently
# drop it and leave NTS-KE with nothing to validate against.
CONFIG_PACKAGE_ca-bundle=y

