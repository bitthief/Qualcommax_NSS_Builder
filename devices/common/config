## ======================================================================
## Service sandboxing — REQUIRED for any of the ujail hardening to apply
## ======================================================================
# This is the missing piece. odhcpd's init gates the jail on
#
#     odhcpd_jailed() { [ -x /sbin/ujail ] && [ -e /etc/capabilities/odhcpd.json ]; }
#
# and uhttpd's does the same. /sbin/ujail comes from procd-ujail, which is a
# separate package and NOT a DEPENDS of either daemon — deliberately, because
# the jail is opt-in. Without it the capabilities file is installed, the ACL is
# installed, the USERID exists, and the daemon still runs as root with
# CapEff=0000001ffffffffff. All the plumbing, none of the effect, and nothing
# says so.
#
# nss-edma-rework already vendors both openwrt/odhcpd#412 patches, so odhcpd
# needs nothing else to drop to uid 455 once ujail is present.
#
# Verify after flashing:
#   grep -E 'Uid|CapEff|NoNewPrivs' /proc/$(pidof odhcpd)/status
#   -> Uid: 455 455 455 / CapEff: 0000000000003400 / NoNewPrivs: 1
CONFIG_PACKAGE_procd-ujail=y
# procd-ujail needs namespace support. Defaults to y unless SMALL_FLASH, which
# this board is not — pinned so a future defconfig change cannot quietly take
# the jail away again.
CONFIG_KERNEL_NAMESPACES=y

# procd-seccomp. Read this before expecting it to filter anything.
#
# Services opt in per-instance with `procd_set_param seccomp <profile>`, and a
# grep across the whole tree finds exactly ONE package that does: umdns. Which
# is also the one package we deliberately dropped, in favour of avahi's
# reflector. Nothing else — not odhcpd, not uhttpd, not dnsmasq, not chrony —
# references a profile, and no other profile exists to reference.
#
# So this is enabled for the TOOLING, not for filtering that happens today:
#   /sbin/utrace, /sbin/seccomp-trace   generate a profile by tracing a running
#                                       service and recording its syscalls
#   /lib/libpreload-seccomp.so          the enforcement shim procd preloads
#
# With KERNEL_SECCOMP=y the InstallSeccomp macro also becomes live, so any
# profile you add to a package is actually installed to /etc/seccomp/ rather
# than silently skipped.
#
# Writing one is a real project, not a config flag. The shape:
#   seccomp-trace /usr/sbin/odhcpd            # exercise it for a while
#   # turn the recorded syscall list into /etc/seccomp/odhcpd.json
#   # add `procd_set_param seccomp /etc/seccomp/odhcpd.json` to the init
# The umdns profile is 59 lines with defaultAction SCMP_ACT_KILL_PROCESS and
# is the reference to copy. Get the syscall list wrong and the daemon is
# killed rather than degraded, which is why this is not a thing to guess at.
CONFIG_PACKAGE_procd-seccomp=y
# Gates both libpreload-seccomp and the InstallSeccomp macro. Defaults to y
# unless SMALL_FLASH; pinned so it cannot quietly disappear.
CONFIG_KERNEL_SECCOMP=y

